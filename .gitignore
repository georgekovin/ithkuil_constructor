```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
env/

# Dependencies
node_modules/

# Logs and temporary files
*.log
*.tmp
*.swp

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Build artifacts
dist/
build/
target/

# Coverage reports
coverage/
htmlcov/
*.coverage

# OS generated files
.DS_Store
Thumbs.db

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/
```